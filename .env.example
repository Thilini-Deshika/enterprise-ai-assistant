# ---------- LLM (choose one; "auto" picks openai > azure > mock based on which key is set) ----------
LLM_PROVIDER=auto                 # auto | openai | azure | mock
OPENAI_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini        # supervisor, validator, rewriting, sub-LM map calls
LLM_MODEL_STRONG=gpt-4o           # final answer + RLM planning/reduce
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Azure OpenAI alternative
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_FAST=gpt-4o-mini
AZURE_DEPLOYMENT_STRONG=gpt-4o
AZURE_DEPLOYMENT_EMBEDDING=text-embedding-3-small

# ---------- Vector DB ----------
VECTOR_BACKEND=auto               # auto | pinecone | local   (auto = pinecone if key set)
PINECONE_API_KEY=
PINECONE_INDEX=enterprise-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
HYBRID_ALPHA=0.6                  # 1.0 = dense only, 0.0 = sparse only
HYBRID_MODE=fusion                # fusion (explainable, 2 queries) | native (1 query, Pinecone convex scaling)

# ---------- LangSmith tracing ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- RLM tuning ----------
# Sub-LM context limit in characters. Lower = more recursive splitting (nice for demos). Default 6000.
RLM_CONTEXT_CHARS=3000
RLM_MAX_DEPTH=2

# ---------- App ----------
# Persona: who the assistant speaks for (used in the system prompt and greetings)
ORG_NAME=Example Bank
ASSISTANT_NAME=Enterprise AI Assistant
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
LOG_LEVEL=INFO
MCP_TRANSPORT=stdio               # stdio (spawned per call) | http (run the MCP server separately)
MCP_URL=http://localhost:8765/mcp
API_URL=http://localhost:8000     # used by the Streamlit UI
# Token-bucket limits per role (JSON). capacity = burst size, refill_per_sec = sustained rate.
RATE_LIMITS={"viewer":{"capacity":5,"refill_per_sec":0.1},"analyst":{"capacity":10,"refill_per_sec":0.2},"administrator":{"capacity":20,"refill_per_sec":0.5}}
# Optional: pin "today" so relative dates ("last year") are reproducible
TODAY_OVERRIDE=2026-10-08
